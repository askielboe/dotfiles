# Theme
theme = "catppuccin-mocha"
macos-titlebar-style = tabs
font-size = 15

# Session management
# window-save-state = never
# window-inherit-working-directory = false

# Keybinds
keybind = ctrl+cmd+j=goto_split:bottom
keybind = ctrl+cmd+h=goto_split:left
keybind = ctrl+cmd+k=goto_split:top
keybind = ctrl+cmd+l=goto_split:right

keybind = ctrl+alt+cmd+j=resize_split:down,10
keybind = ctrl+alt+cmd+h=resize_split:left,10
keybind = ctrl+alt+cmd+k=resize_split:up,10
keybind = ctrl+alt+cmd+l=resize_split:right,10

keybind = global:cmd+$=toggle_quick_terminal
