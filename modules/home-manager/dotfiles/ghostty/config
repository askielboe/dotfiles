# Theme
theme = "Catppuccin Mocha"
macos-titlebar-style = tabs
font-size = 15

# Session management
# window-save-state = never
# window-inherit-working-directory = false

# Keybinds
# https://ghostty.org/docs/config/keybind

# Option as alt
macos-option-as-alt = true
keybind = alt+8=text:[
keybind = alt+9=text:]
keybind = shift+alt+7=text:\\
keybind = shift+alt+8=text:{
keybind = shift+alt+9=text:}
keybind = alt+¨=text:~
keybind = alt+'=text:@
keybind = alt+i=text:|

# Split navigation
keybind = ctrl+cmd+j=goto_split:bottom
keybind = ctrl+cmd+h=goto_split:left
keybind = ctrl+cmd+k=goto_split:top
keybind = ctrl+cmd+l=goto_split:right

keybind = ctrl+alt+cmd+j=resize_split:down,10
keybind = ctrl+alt+cmd+h=resize_split:left,10
keybind = ctrl+alt+cmd+k=resize_split:up,10
keybind = ctrl+alt+cmd+l=resize_split:right,10

# Shell integration (also enables cwd inheritance for new tabs/splits via OSC 7)
shell-integration = detect

# Better copy/paste for code blocks
clipboard-paste-protection = false
clipboard-paste-bracketed-safe = false

scrollback-limit = 10000000
mouse-hide-while-typing = true

unfocused-split-opacity = 1
