#!/bin/bash
# sketchybar config — Catppuccin Mocha with AeroSpace workspaces on the left.
# The launchd agent comes from modules/darwin/settings/sketchybar.nix; this
# file is symlinked to ~/.config/sketchybar by darwin-specific.nix.
# Manual reload: sketchybar --reload
#
# Item definitions live in items/*.sh, one file per bar item (or logical
# group). They are sourced (same shell) in the explicit left-to-right order
# below — that source order IS the on-screen order, since sketchybar places
# items within each region in definition order. Reordering the bar means
# reordering this list. Sourced files inherit $CONFIG_DIR, $PLUGIN_DIR,
# $AEROSPACE and the colour vars set here without re-export.
#
# To add an item: create items/<name>.sh and add a `source` line below,
# positioned to match where it should appear in its region.

# shellcheck source=colors.sh
source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"
AEROSPACE="/opt/homebrew/bin/aerospace"

# ---- bar & defaults ---------------------------------------------------------

# notch_width tells sketchybar how wide the built-in display's notch is, so the
# native q (left-of-notch) / e (right-of-notch) item positions sit flush beside
# it. It applies ONLY to the internal notched display — on external monitors the
# notch region is zero-width, so q/e collapse toward centre automatically (no
# per-display logic needed). The 16" MBP notch measures ~185pt; 200 leaves a
# little clearance. The focus HUD (pomodoro + micromanager) uses q — see below.
# topmost=on keeps the bar drawn above regular application windows. Without it
# (the default topmost=off) tiled/maximised windows — especially on external
# displays like the Dell — render on top of the bar and hide it. AeroSpace's
# top gap reserves the space, but z-order still needs this to stay on top.
sketchybar --bar \
  position=top \
  height=34 \
  display=all \
  topmost=on \
  notch_width=200 \
  color="$BAR_COLOR" \
  blur_radius=20 \
  padding_left=8 \
  padding_right=8

sketchybar --default \
  icon.font="Hack Nerd Font:Bold:14.0" \
  icon.color="$TEXT" \
  icon.padding_left=6 \
  icon.padding_right=4 \
  label.font="Hack Nerd Font:Regular:13.0" \
  label.color="$TEXT" \
  label.padding_left=4 \
  label.padding_right=6 \
  background.corner_radius=6 \
  background.height=20

# ---- items (source order = on-screen order) ---------------------------------

# Left region (left → right):
# shellcheck source=items/workspaces.sh
source "$ITEM_DIR/workspaces.sh" # aerospace spaces + window pool + controller
# shellcheck source=items/front_app.sh
# source "$ITEM_DIR/front_app.sh" # focused application
# shellcheck source=items/gchat.sh
source "$ITEM_DIR/gchat.sh"
# shellcheck source=items/productive.sh
source "$ITEM_DIR/productive.sh"
# shellcheck source=items/meeting.sh
source "$ITEM_DIR/meeting.sh"

# Focus HUD (pomodoro + micromanager) — position "q" (native: left of the notch).
# It sits just left of centre, flush against the notch, and on a non-notched
# display collapses toward centre. Left of the notch, not right ("e"), because
# the right region is wide enough to overlap an e-anchored item. See notch_width
# on the bar above; sketchybar handles the per-display placement, no detection.
# shellcheck source=items/pomodoro.sh
source "$ITEM_DIR/pomodoro.sh" # current focus / pomodoro
# shellcheck source=items/micromanager.sh
source "$ITEM_DIR/micromanager.sh" # micromanager focus-block timer + app glyphs

# Right region (defined left → right; sketchybar stacks them right → left, so
# the first-sourced item is rightmost):
# shellcheck source=items/clock.sh
source "$ITEM_DIR/clock.sh"
# shellcheck source=items/battery.sh
source "$ITEM_DIR/battery.sh"
# shellcheck source=items/disk.sh
source "$ITEM_DIR/disk.sh"
# shellcheck source=items/temp.sh
source "$ITEM_DIR/temp.sh"
# shellcheck source=items/volume.sh
source "$ITEM_DIR/volume.sh"
# shellcheck source=items/network.sh
source "$ITEM_DIR/network.sh"
# shellcheck source=items/gpu.sh
source "$ITEM_DIR/gpu.sh"
# shellcheck source=items/cpu.sh
source "$ITEM_DIR/cpu.sh"
# shellcheck source=items/stats_controller.sh
source "$ITEM_DIR/stats_controller.sh"
# shellcheck source=items/claude_usage.sh
source "$ITEM_DIR/claude_usage.sh"

# ---- init --------------------------------------------------------------------

sketchybar --update
"$PLUGIN_DIR/aerospace.sh" # paint initial workspace state
